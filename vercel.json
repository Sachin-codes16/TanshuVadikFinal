{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://api.tanshuvaidik.com/api/:path*"
    },
    {
      "source": "/media-proxy/admin/:path*",
      "destination": "http://admin.tanshuvaidik.com/:path*"
    },
    {
      "source": "/media-proxy/api/:path*",
      "destination": "http://api.tanshuvaidik.com/:path*"
    },
    {
      "source": "/((?!api/|media-proxy/|assets/|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ]
}
